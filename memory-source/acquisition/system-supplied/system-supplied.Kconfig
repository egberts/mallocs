#if MEMORY_SOURCE_SYSTEM

comment "System-supplied - Operating system provides or maps the resource"

config MEMORY_SOURCE_SYSTEM_MMAP
    bool "mmap()"
    depends on !MEMORY_SOURCE_GLOBAL_OBJECT && !MEMORY_SOURCE_STATICALLY_RESERVED_ARRAY
    help
      Trying mmap()
# source "memory-source/acquisition/statically/global-static/global-static.Kconfig"

config MEMORY_SOURCE_SYSTEM_SBRK
    bool "sbrk()"
    help
      Trying sbrk()

config MEMORY_SOURCE_SYSTEM_GLIB_MALLOC
    bool "Standard glib malloc()"
    help
      Trying glib malloc()

config MEMORY_SOURCE_SYSTEM_LINUX_SHMEM
    bool "Linux shared memory, by interface"
    help
      Trying Linux /dev/shmem()

#endif