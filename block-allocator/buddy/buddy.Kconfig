#if MALLOC_BLOCK_ALLOCATOR_BUDDY

choice
        prompt "Buddy algorithm"
        default MALLOC_BUDDY_BINARY
        help
          Select the buddy allocation algorithm.

          Buddy algorithms are mutually exclusive. Exactly one
          algorithm is selected.

config MALLOC_BUDDY_BINARY
        bool "Binary buddy"

config MALLOC_BUDDY_FIBONACCI
        bool "Fibonacci buddy"

config MALLOC_BUDDY_WEIGHTED
        bool "Weighted buddy"

config MALLOC_BUDDY_DOUBLE
        bool "Double buddy"

endchoice

source "block-allocator/buddy/binary/binary.Kconfig"
source "block-allocator/buddy/fibonacci/fibonacci.Kconfig"
source "block-allocator/buddy/weighted/weighted.Kconfig"
source "block-allocator/buddy/double/double.Kconfig"


#endif
