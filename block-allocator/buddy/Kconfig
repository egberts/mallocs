if MALLOC_BLOCK_ALLOCATOR_BUDDY

comment "Buddy allocators"

choice
        prompt "Buddy algorithm"
        default MALLOC_BUDDY_BINARY
        help
          Select the buddy allocation algorithm.

          Buddy algorithms are mutually exclusive. Exactly one
          algorithm is selected.

config MALLOC_BUDDY_BINARY
        bool "Binary buddy"

config MALLOC_BUDDY_FIBONACCI
        bool "Fibonacci buddy"

config MALLOC_BUDDY_WEIGHTED
        bool "Weighted buddy"

config MALLOC_BUDDY_DOUBLE
        bool "Double buddy"

endchoice

#if MALLOC_BUDDY_BINARY
source "block-allocator/buddy/binary/Kconfig"
#endif
#if MALLOC_BUDDY_FIBONACCI
source "block-allocator/buddy/fibonacci/Kconfig"
#endif
#if MALLOC_BUDDY_WEIGHTED
source "block-allocator/buddy/weighted/Kconfig"
#endif
#if MALLOC_BUDDY_DOUBLE
source "block-allocator/buddy/double/Kconfig"
#endif


endif
