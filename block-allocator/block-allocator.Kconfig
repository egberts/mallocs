
comment "Block allocators - Given memory available for allocation, how is an allocatable block selected and represented?"

config MALLOC_BLOCK_SIZE_SELECTORS
        bool "Size selectors"

config MALLOC_BLOCK_BIN
        bool "Bin selectors (hashed)"

config MALLOC_BLOCK_ALLOCATOR_SEGREGATED_FREE_LIST
        bool "Segregated free list allocator"
if MALLOC_BLOCK_ALLOCATOR_SEGREGATED_FREE_LIST
source "block-allocator/segregated-free-list/segregated.Kconfig"
endif


config MALLOC_BLOCK_ALLOCATOR_BITMAP
        bool "Bitmap block allocator"
if MALLOC_BLOCK_ALLOCATOR_BITMAP
